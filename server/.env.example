# =============================
# Server Environment (Example)
# Copy to: server/.env
# =============================

# Node environment: development | production
NODE_ENV=development

# Server port
PORT=5050

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/car_platform

# JWT secret (use a long random string in real .env)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# JWT expiry (e.g. 7d, 1h, 30m)
JWT_EXPIRES_IN=7d

# Production: comma-separated exact HTTPS website origins (no trailing slash)
# CORS_ORIGINS=https://carvia.example.com
# Production: absolute path on persistent storage; shared by uploads and photo checks
# UPLOAD_DIR=/data/uploads

# Account mail: configure a verified sender with your chosen SMTP provider.
# Credentials belong in .env / deployment secrets, never in source control.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# PUBLIC_WEB_URL=http://localhost:3000
# Production automatically requires verified email for buyer enquiries.
# To rehearse that requirement locally after configuring delivery:
# REQUIRE_VERIFIED_EMAIL=true
